# Zaim OAuth 1.0a credentials
# 取得手順: https://dev.zaim.net でアプリケーションを登録し、コンシューマ情報を取得する

# 1) アプリ登録後に発行されるコンシューマ情報
ZAIM_CONSUMER_KEY="your-consumer-key"
ZAIM_CONSUMER_SECRET="your-consumer-secret"

# 2) OAuth 認可フロー完了後に取得するアクセストークン
#    初回は空のまま `python zaim_poc.py authorize` を実行して取得する
ZAIM_ACCESS_TOKEN=""
ZAIM_ACCESS_TOKEN_SECRET=""
